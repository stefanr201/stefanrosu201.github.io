{
  "rewrites": [
    {
      "source": "/folio",
      "destination": "https://money-tracker-api-virid.vercel.app/folio/login"
    },
    {
      "source": "/folio/",
      "destination": "https://money-tracker-api-virid.vercel.app/folio/login"
    },
    {
      "source": "/folio/:path*",
      "destination": "https://money-tracker-api-virid.vercel.app/folio/:path*"
    }
  ],
  "headers": [
    {
      "source": "/folio/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ]
}
